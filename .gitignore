# Whitelist: ignore everything, then allow only code, docs and small metadata.
*
!.gitignore
!README.md
!config.sh
!config.local.sh.example
!scripts/
!scripts/*
!metadata/
!metadata/*.tsv
!metadata/*.txt
!docs/
!docs/*.md
!results/
!results/trackA/
!results/trackA/de/
!results/trackA/de/*.tsv
!results/trackA/gsea/
!results/trackA/gsea/*.tsv
!results/trackA/qc/
!results/trackA/qc/*.tsv
!results/trackA/plots/
!results/trackA/plots/*.png
!results/trackA/plots/*.pdf
!teaching_deseq2/
!teaching_deseq2/README.md
!teaching_deseq2/*.R
!teaching_deseq2/*.Rproj
!teaching_deseq2/data/
!teaching_deseq2/data/*
!trackB_salmon/
!trackB_salmon/README.md
!trackB_salmon/config.sh
!trackB_salmon/scripts/
!trackB_salmon/scripts/*
!trackB_salmon/metadata/
!trackB_salmon/metadata/*.txt
!trackB_salmon/metadata/*.tsv
!trackB_salmon/results/
!trackB_salmon/results/de/
!trackB_salmon/results/de/*.tsv
!trackB_salmon/results/gsea/
!trackB_salmon/results/gsea/*.tsv
!trackB_salmon/results/qc/
!trackB_salmon/results/qc/*
!trackB_salmon/results/plots/
!trackB_salmon/results/plots/*
# never track site settings, data, logs, R session info (contains local paths)
*sessionInfo*
*.rds
config.local.sh
fastq/
logs/
